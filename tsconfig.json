{
    "compilerOptions": {
        /* Language and Environment */
        "target": "ESNext",

        /* Modules */
        "module": "ESNext",
        "moduleResolution": "bundler",

        /* JavaScript Support */
        "allowJs": true,

        /* Emit */
        "noEmit": true,

        /* Interop Constraints */
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,

        /* Type Checking */
        "strict": true,
        "noImplicitAny": true,

        /* Skip checking library declaration files */
        "skipLibCheck": true,

        /* Path Aliases */
        "paths": {
            "@/*": ["./resources/js/*"]
        },

        /* JSX */
        "jsx": "react-jsx"
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.tsx"
    ]
}